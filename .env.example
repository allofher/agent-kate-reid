# Strudel server
STRUDEL_URL=http://localhost:3000

# Inference provider — pick one
PROVIDER=anthropic          # anthropic | openai | openrouter | ollama

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI / OpenRouter
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenRouter, etc.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Model to use (provider-specific name)
MODEL=claude-opus-4-7
